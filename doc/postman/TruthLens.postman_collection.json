{
  "info": {
    "name": "TruthLens API (v0.2)",
    "description": "Backend endpoints in backend/routers/scanner.py. No API keys are needed here: the Groq key stays on the server.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "item": [
    {
      "name": "Health",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": []
        },
        "description": ""
      }
    },
    {
      "name": "Scan text",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/scan/text",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "scan",
            "text"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"The Great Wall of China is visible from space.\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Scan text: empty (expects 422)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 422', function () { pm.response.to.have.status(422); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/scan/text",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "scan",
            "text"
          ]
        },
        "description": "",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"text\": \"\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Scan URL",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/scan/url",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "scan",
            "url"
          ]
        },
        "description": "Needs a page with readable article text for a useful result.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"https://example.com/\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Scan URL: localhost (expects 422)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 422', function () { pm.response.to.have.status(422); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/scan/url",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "scan",
            "url"
          ]
        },
        "description": "Non-public addresses are blocked.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"url\": \"http://127.0.0.1/\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "Scan media",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/scan/media",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "scan",
            "media"
          ]
        },
        "description": "Attach a .mp3, .mp4, .wav or .m4a file up to 25MB.",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "file",
              "type": "file",
              "src": []
            }
          ]
        }
      }
    }
  ]
}