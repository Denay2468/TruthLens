# Copy this file to .env and fill in your own values. Never commit .env to git.

# Get a free key at https://console.groq.com
# Used for both fact-checking (LLM) and media transcription (hosted Whisper)
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the fact-checking model (default: openai/gpt-oss-20b).
# Check https://console.groq.com/docs/models for current model names.
# GROQ_MODEL=

# Browser origins allowed to call this API (comma-separated).
# Default allows local development only. Add your deployed frontend URL.
# ALLOWED_ORIGINS=http://localhost:5173,https://your-frontend.example

# Max scan requests per client IP per minute (0 disables the limiter).
# RATE_LIMIT_PER_MINUTE=20

# PLANNED (Sprint 2, not used by the code yet): Google Fact Check Tools API key.
# FACT_CHECK_API_KEY=
